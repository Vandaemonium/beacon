{
  "manifest_version": 3,
  "name": "Beacon Hub",
  "version": "1.2.1",
  "description": "Beacon Hub \u2014 Live TV plus a streaming-style movie & TV browser with Trakt sync, Premiumize cloud and your own source providers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Beacon Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "version_name": "Beacon Hub 1.2.1"
}
